# Copy this file to docker/nexus/.env. Never commit the copied file.
NEXUS_IMAGE=sonatype/nexus3:3.96.3
NEXUS_URL=http://127.0.0.1:8082
NEXUS_ADMIN_USERNAME=admin
# On the first run, read this value with:
# docker compose --env-file docker/nexus/.env -f docker/nexus/compose.yaml exec nexus cat /nexus-data/admin.password
NEXUS_ADMIN_PASSWORD=
NEXUS_PUBLISHER_USERNAME=stayledger-publisher
NEXUS_PUBLISHER_PASSWORD=
